# Salin jadi .env.local lalu isi. Tanpa dua kunci Supabase, app berjalan dalam mode demo.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase > Project Settings > API > service_role. Rahasia: jangan ditempel di chat atau di-commit.
SUPABASE_SERVICE_ROLE_KEY=
# Kata sandi halaman /admin. Wajib di produksi.
ADMIN_PASSWORD=
# String acak bebas, untuk menandatangani cookie admin.
ADMIN_SECRET=
